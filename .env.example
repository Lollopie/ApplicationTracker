# Copy to .env and fill in your own values. Never commit .env.

# The Postgres container creates a database named after the user,
# so keep DATABASE_NAME and the database in DATABASE_URL equal to DATABASE_USER.
DATABASE_USER=jobtracker
DATABASE_PASSWORD=change-me
DATABASE_NAME=jobtracker
# "postgres" is the Compose service name. Use localhost when running the app from your IDE.
DATABASE_URL=jdbc:postgresql://postgres:5432/jobtracker

# BCrypt hash of the seeded admin's password, prefixed with {bcrypt}.
# Keep the single quotes so Compose doesn't expand the $ characters.
# Generate one with: htpasswd -bnBC 12 "" 'your-admin-password' | tr -d ':\n'
ADMIN_PASSWORD_HASH='{bcrypt}$2y$12$replace.with.your.own.hash.................................'
